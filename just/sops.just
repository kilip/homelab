# SOPS + age helpers for secrets.
#
# Usage:  just sops <recipe>
# File arguments are relative to the repository root.

set working-directory := '..'

# The age private key. It is git-ignored: NEVER commit it.
key_file := env('SOPS_AGE_KEY_FILE', justfile_directory() / 'age.key')

export SOPS_AGE_KEY_FILE := key_file

# List the recipes of this module (also runs on a bare `just sops`)
[private]
default:
    @just --list sops

# Generate the age key and .sops.yaml (never overwrites an existing key or config)
init:
    #!/usr/bin/env bash
    set -euo pipefail
    key="{{key_file}}"
    if ! command -v age-keygen >/dev/null 2>&1; then
        echo "age-keygen not found. Install age first: https://github.com/FiloSottile/age" >&2
        exit 1
    fi
    if [ -s "$key" ]; then
        echo "Age key already exists: $key (left untouched)."
    else
        if [ -e .sops.yaml ]; then
            echo ".sops.yaml exists but $key is missing." >&2
            echo "Restore the original key instead of generating a new one that would not match." >&2
            exit 1
        fi
        umask 077
        mkdir -p "$(dirname "$key")"
        age-keygen -o "$key" 2>/dev/null
        chmod 600 "$key"
        echo "Generated age key: $key"
    fi
    pub="$(age-keygen -y "$key")"
    if [ -e .sops.yaml ]; then
        echo ".sops.yaml already exists (left untouched)."
    else
        sed "s|__AGE_PUBLIC_KEY__|${pub}|g" > .sops.yaml <<'EOF'
    # SOPS creation rules. Generated by `just sops init`.
    # File naming convention: secrets live in files called *.sops.yaml.
    creation_rules:
      # Ansible variables (loaded by the community.sops vars plugin): encrypt every value.
      - path_regex: ^ansible/.*\.sops\.ya?ml$
        age: __AGE_PUBLIC_KEY__
      # Kubernetes manifests: encrypt only data/stringData so the rest stays reviewable.
      # Flux decrypts these in-cluster with the sops-age secret.
      - path_regex: ^k8s/.*\.sops\.ya?ml$
        encrypted_regex: ^(data|stringData)$
        age: __AGE_PUBLIC_KEY__
    EOF
        echo "Wrote .sops.yaml"
    fi
    echo
    echo "Public key : $pub"
    echo "Private key: $key (git-ignored)"
    echo
    echo "Back up the private key NOW, e.g. into a password manager:  just sops export-key"
    echo "If it is lost, every secret encrypted in this repository is lost with it."

# Print the age public key
pubkey:
    age-keygen -y "{{key_file}}"

# Print the PRIVATE key so it can be copied into a password manager
export-key:
    @echo "# PRIVATE KEY: store it in a password manager. Never commit or share it." >&2
    @cat "{{key_file}}"

# Encrypt a file in place, e.g. just sops encrypt k8s/apps/foo/secret.sops.yaml
encrypt file:
    sops --encrypt --in-place "{{file}}"

# Decrypt a file to stdout (the file on disk stays encrypted)
decrypt file:
    sops --decrypt "{{file}}"

# Edit an encrypted file in $EDITOR (decrypts, then re-encrypts on save)
edit file:
    sops "{{file}}"

# Fail if a *.sops.yaml file is not encrypted or a Kubernetes Secret is committed in plaintext
check:
    #!/usr/bin/env bash
    set -euo pipefail
    bad=0
    while IFS= read -r f; do
        if ! grep -q '^sops:' "$f"; then
            echo "NOT ENCRYPTED: $f"
            bad=1
        fi
    done < <(find ansible k8s -type f \( -name '*.sops.yaml' -o -name '*.sops.yml' \) 2>/dev/null)
    while IFS= read -r f; do
        case "$f" in
            *.sops.yaml|*.sops.yml) ;;
            *)
                echo "PLAINTEXT SECRET (rename to *.sops.yaml and encrypt): $f"
                bad=1
                ;;
        esac
    done < <(grep -rlE --include='*.yaml' --include='*.yml' '^kind:[[:space:]]*Secret[[:space:]]*$' k8s 2>/dev/null || true)
    if [ "$bad" -ne 0 ]; then
        exit 1
    fi
    echo "OK: no unencrypted secrets found."
